#!/usr/bin/env bash
# start-grok: portero (:7999) + Hermes API (:8642) + túnel ngrok. El tutor :8000 lo enciende el portero.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BACKEND="${ROOT}/backend"
LOGDIR="${HOME}/Library/Logs/besto-friendo"
NGROK_URL="https://pug-stump-approve.ngrok-free.dev"
# LaunchAgent no trae ~/.local/bin (donde el installer pone `hermes`).
export PATH="${HOME}/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH}"
mkdir -p "$LOGDIR"

# El Mini (y cualquier Mac) puede suspenderse enchufado. -s = idle del sistema; -w $$ sigue a este PID tras el exec ngrok.
if command -v caffeinate >/dev/null 2>&1; then
  caffeinate -s -w $$ >/dev/null 2>&1 &
fi

echo "start-grok: portero + Hermes + túnel (el tutor :8000 sale solo al usar el móvil)"

if ! lsof -nP -iTCP:7999 -sTCP:LISTEN >/dev/null 2>&1; then
  # shellcheck source=/dev/null
  source "${BACKEND}/.venv/bin/activate"
  cd "$BACKEND"
  nohup uvicorn app.boot:app --host 127.0.0.1 --port 7999 \
    >>"${LOGDIR}/boot.log" 2>&1 &
  echo "listen :7999 pid $!"
else
  echo "listen :7999 ya estaba"
fi

for _ in $(seq 1 40); do
  code="$(curl -sS -o /dev/null -w "%{http_code}" "http://127.0.0.1:7999/boot/status" || echo 000)"
  # 401 = portero vivo (pide secreto). 000 = aún no escucha.
  if [[ "$code" == "401" || "$code" == "503" || "$code" == "200" ]]; then
    break
  fi
  sleep 0.5
done

# Sidecar del modo conversación (web search). El installer de Hermes lo pone en launchd.
# en foreground choca. Si :8642 no está, restart/start del servicio.
_hermes=""
if command -v hermes >/dev/null 2>&1; then
  _hermes="$(command -v hermes)"
elif [[ -x "${HOME}/.local/bin/hermes" ]]; then
  _hermes="${HOME}/.local/bin/hermes"
fi
_wait_hermes_api() {
  for _ in $(seq 1 40); do
    if lsof -nP -iTCP:8642 -sTCP:LISTEN >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}
if [[ -n "$_hermes" ]]; then
  if lsof -nP -iTCP:8642 -sTCP:LISTEN >/dev/null 2>&1; then
    echo "hermes :8642 ya estaba"
  else
    # Sin LaunchAgent, `gateway restart/start` se queda en foreground y nunca llega a ngrok.
    echo "hermes gateway restart (background; si hay launchd, él lo recoge)"
    (
      "$_hermes" gateway restart >>"${LOGDIR}/hermes.log" 2>&1 \
        || "$_hermes" gateway start >>"${LOGDIR}/hermes.log" 2>&1 \
        || true
    ) &
    if _wait_hermes_api; then
      echo "hermes API en :8642"
    else
      echo "hermes :8642 no escuchó. Mira ${LOGDIR}/hermes.log (API_SERVER_ENABLED en ~/.hermes/.env)" >&2
    fi
  fi
else
  echo "sin binario hermes; el router de Besto seguirá en Groq" >&2
fi

if command -v ngrok >/dev/null 2>&1; then
  _ngrok_cfg="${HOME}/Library/Application Support/ngrok/ngrok.yml"
  [[ -f "${HOME}/.config/ngrok/ngrok.yml" ]] && _ngrok_cfg="${HOME}/.config/ngrok/ngrok.yml"
  if [[ -f "$_ngrok_cfg" ]] && grep -q "authtoken:" "$_ngrok_cfg" 2>/dev/null; then
    echo "túnel ${NGROK_URL}"
    exec ngrok http 7999 --url "$NGROK_URL"
  fi
fi

echo "Falta ngrok o el authtoken (ngrok config add-authtoken …)" >&2
exit 1
