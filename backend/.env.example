# Origins del front, separados por coma. El del móvil (Vercel) tiene que ir aquí o CORS bloquea el audio.
FRONTEND_ORIGIN=http://localhost:3000
APP_NAME=besto-friendo
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Nombre Cast (substring). Vacío = primer Chromecast / el que parezca TV.
TV_CAST_NAME=
# IP de la tele (GET /tv/casts). Con esto se salta el discovery mDNS.
TV_CAST_HOST=
# IP de la PS5. Empareja una vez: pyremoteplay $PS5_HOST --register
PS5_HOST=
# MAC (aa:bb:cc:dd:ee:ff). WoL si aún no hay perfil Remote Play.
PS5_MAC=
# Usuario pyremoteplay. Vacío = el primero registrado.
PS5_USER=
# HDMI n = mismo recorrido; DOWN + (n-1).
TV_HDMI1_UP=2
TV_HDMI1_RIGHT=5
TV_HDMI1_TOP=12
TV_HDMI1_DOWN=5
# Cuenta MIGo Link. Nunca las subas a git.
# MIGO_BRAND=sdbg es Saunier Duval (no uses saunier_duval: myPyllant no lo reconoce).
MIGO_EMAIL=
MIGO_PASSWORD=
MIGO_BRAND=sdbg
MIGO_COUNTRY=spain
